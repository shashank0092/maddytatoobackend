    {
      "name": "Logout",
      "item": [
        {
          "name": "Valid Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Success is true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "pm.test(\"Logout message exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.message).to.eql(\"Logged out successfully\");",
                  "});",
                  "pm.test(\"Authentication cookie is cleared\", function () {",
                  "    var setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "    if (setCookie) {",
                  "        // max-age=0 or expires in past implies clear",
                  "        pm.expect(setCookie.toLowerCase()).to.satisfy(val => val.includes('max-age=0') || val.includes('expires=th') || val.includes('expires=jan 1') || val.includes('expires=thu, 01 jan 1970'));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        },
