{
  "info": {
    "name": "Maddy's Tattoo & Art - Auth API",
    "description": "Postman test collection for the Authentication module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "CHANGE_ME",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Valid Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Success is true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "pm.test(\"User object exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user).to.exist;",
                  "    pm.expect(jsonData.data.user.id).to.exist;",
                  "    pm.expect(jsonData.data.user.email).to.exist;",
                  "    pm.expect(jsonData.data.user.email).to.eql(pm.variables.get(\"admin_email\").trim().toLowerCase());",
                  "});",
                  "pm.test(\"Sensitive data is not returned\", function () {",
                  "    var responseBody = pm.response.text();",
                  "    pm.expect(responseBody).to.not.include(\"password_hash\");",
                  "    pm.expect(responseBody).to.not.include(\"password\\\":\");",
                  "    pm.expect(responseBody).to.not.include(\"token\\\":\");",
                  "});",
                  "pm.test(\"Authentication cookie is created\", function () {",
                  "    var setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "    pm.expect(setCookie).to.exist;",
                  "    pm.expect(setCookie).to.include(\"HttpOnly\");",
                  "});",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Invalid Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Success is false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});",
                  "pm.test(\"Error object exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "    pm.expect(jsonData.error.message).to.eql(\"Invalid email or password\");",
                  "});",
                  "pm.test(\"Authentication cookie is not created\", function () {",
                  "    var setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "    if (setCookie) {",
                  "        pm.expect(setCookie).to.not.include(\"HttpOnly\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
