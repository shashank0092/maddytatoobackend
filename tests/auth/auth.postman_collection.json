    {
      "name": "Authentication State",
      "item": [
        {
          "name": "Verify Authenticated Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request is authenticated\", function () {",
                  "    // If the endpoint doesn't exist, it might return 404.",
                  "    // But it MUST NOT return 401 because authentication passed.",
                  "    pm.expect(pm.response.code).to.not.eql(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "content"
              ]
            },
            "description": "Tests an authenticated request against a protected endpoint. Note: The /content endpoint might not exist yet, returning 404, but it should not return 401."
          }
        },
        {
          "name": "Verify Unauthenticated Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.cookies.clear();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Success is false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "content"
              ]
            }
          }
        }
      ]
