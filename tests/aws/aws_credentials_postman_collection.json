{
  "info": {
    "_postman_id": "c1f6b8b0-5c6a-4b9e-9d2c-8a1e5d7f9c3e",
    "name": "Maddy Tattoo - AWS Cognito Integration",
    "description": "Tests for the AWS Cognito Developer-Authenticated Identity API bridge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get AWS Credentials - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Success is true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Data exists and contains identityId and token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "    pm.expect(jsonData.data.identityId).to.exist;",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "});",
                  "",
                  "pm.test(\"IdentityId and Token are strings\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.identityId).to.be.a('string');",
                  "    pm.expect(jsonData.data.token).to.be.a('string');",
                  "});",
                  "",
                  "pm.test(\"AWS permanent credentials are NOT present\", function () {",
                  "    var responseBody = pm.response.text();",
                  "    pm.expect(responseBody).to.not.include(\"AWS_ACCESS_KEY_ID\");",
                  "    pm.expect(responseBody).to.not.include(\"AWS_SECRET_ACCESS_KEY\");",
                  "    pm.expect(responseBody).to.not.include(\"awsSecretAccessKey\");",
                  "    pm.expect(responseBody).to.not.include(\"secretAccessKey\");",
                  "    pm.expect(responseBody).to.not.include(\"accessKeyId\");",
                  "    pm.expect(responseBody).to.not.include(\"sessionToken\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "access_token={{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/aws-credentials",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "aws-credentials"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get AWS Credentials - Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Success is false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});",
                  "",
                  "pm.test(\"Error code is UNAUTHORIZED\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "    pm.expect(jsonData.error.code).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/aws-credentials",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "aws-credentials"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get AWS Credentials - AWS Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "",
                  "pm.test(\"Success is false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});",
                  "",
                  "pm.test(\"Error code is AWS_IDENTITY_ERROR\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "    pm.expect(jsonData.error.code).to.eql(\"AWS_IDENTITY_ERROR\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "access_token={{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/aws-credentials",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "aws-credentials"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
