generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A minimal user model to ensure Prisma can generate the client
// Full authentication module implementation will expand this later.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password_hash String
  first_name    String
  last_name     String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz()
  last_login_at DateTime? @db.Timestamptz()

  @@map("users")
}

model ContentType {
  id              String                    @id @default(uuid()) @db.Uuid
  slug            String                    @unique
  cover_image_key String?
  is_active       Boolean                   @default(true)

  created_at      DateTime                  @default(now()) @db.Timestamptz()
  updated_at      DateTime                  @updatedAt @db.Timestamptz()

  translations    ContentTypeTranslation[]

  @@map("content_types")
}

model ContentTypeTranslation {
  id              String      @id @default(uuid()) @db.Uuid

  content_type_id String      @db.Uuid
  language_code   String

  name            String
  description     String?
  alt_text        String?

  created_at      DateTime    @default(now()) @db.Timestamptz()
  updated_at      DateTime    @updatedAt @db.Timestamptz()

  content_type    ContentType @relation(fields: [content_type_id], references: [id], onDelete: Cascade)

  @@unique([content_type_id, language_code])
  @@index([language_code])
  @@map("content_type_translations")
}
