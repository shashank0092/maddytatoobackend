generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A minimal user model to ensure Prisma can generate the client
// Full authentication module implementation will expand this later.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password_hash String
  first_name    String
  last_name     String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz()
  last_login_at DateTime? @db.Timestamptz()

  @@map("users")
}

model ContentType {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  cover_image_key String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations ContentTypeTranslation[]
  contents     Content[]

  @@map("content_types")
}

model ContentTypeTranslation {
  id String @id @default(uuid()) @db.Uuid

  content_type_id String @db.Uuid
  language_code   String

  name        String
  description String?
  alt_text    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  content_type ContentType @relation(fields: [content_type_id], references: [id], onDelete: Cascade)

  @@unique([content_type_id, language_code])
  @@index([language_code])
  @@map("content_type_translations")
}

model Category {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  cover_image_key String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations CategoryTranslation[]
  contents     Content[]

  @@map("categories")
}

model CategoryTranslation {
  id String @id @default(uuid()) @db.Uuid

  category_id   String @db.Uuid
  language_code String

  name        String
  description String?
  alt_text    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, language_code])
  @@index([language_code])
  @@map("category_translations")
}

model Collection {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  cover_image_key String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations CollectionTranslation[]
  contents     Content[]

  @@map("collections")
}

model CollectionTranslation {
  id String @id @default(uuid()) @db.Uuid

  collection_id String @db.Uuid
  language_code String

  name        String
  description String?
  alt_text    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  @@unique([collection_id, language_code])
  @@index([language_code])
  @@map("collection_translations")
}

model Style {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  cover_image_key String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations StyleTranslation[]
  contents     Content[]

  @@map("styles")
}

model StyleTranslation {
  id String @id @default(uuid()) @db.Uuid

  style_id      String @db.Uuid
  language_code String

  name        String
  description String?
  alt_text    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  style Style @relation(fields: [style_id], references: [id], onDelete: Cascade)

  @@unique([style_id, language_code])
  @@index([language_code])
  @@map("style_translations")
}

model BodyPlacement {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  cover_image_key String?
  is_active       Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations BodyPlacementTranslation[]
  contents     Content[]

  @@map("body_placements")
}

model BodyPlacementTranslation {
  id String @id @default(uuid()) @db.Uuid

  body_placement_id String @db.Uuid
  language_code     String

  name        String
  description String?
  alt_text    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  body_placement BodyPlacement @relation(fields: [body_placement_id], references: [id], onDelete: Cascade)

  @@unique([body_placement_id, language_code])
  @@index([language_code])
  @@map("body_placement_translations")
}

model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  translations TagTranslation[]
  contents     ContentTag[]

  @@map("tags")
}

model TagTranslation {
  id            String   @id @default(uuid()) @db.Uuid
  tag_id        String   @db.Uuid
  language_code String
  name          String
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  tag Tag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([tag_id, language_code])
  @@index([language_code])
  @@map("tag_translations")
}

// -----------------------------------------------------------------------------
// MAIN CONTENT MODULE
// -----------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaRole {
  COVER
  GALLERY
  PROCESS
  VIDEO
}

enum DisplaySurface {
  HOME
  DISCOVER
  MUSEUM
  COMMUNITY
}

enum DisplayType {
  FEATURED
  LATEST
  EDITOR_PICK
  SPOTLIGHT
}

model Content {
  id                String        @id @default(uuid()) @db.Uuid
  content_type_id   String        @db.Uuid
  category_id       String?       @db.Uuid
  collection_id     String?       @db.Uuid
  style_id          String?       @db.Uuid
  body_placement_id String?       @db.Uuid
  slug              String        @unique
  status            ContentStatus @default(DRAFT)
  published_at      DateTime?     @db.Timestamptz()
  created_at        DateTime      @default(now()) @db.Timestamptz()
  updated_at        DateTime      @updatedAt @db.Timestamptz()

  content_type   ContentType    @relation(fields: [content_type_id], references: [id])
  category       Category?      @relation(fields: [category_id], references: [id])
  collection     Collection?    @relation(fields: [collection_id], references: [id])
  style          Style?         @relation(fields: [style_id], references: [id])
  body_placement BodyPlacement? @relation(fields: [body_placement_id], references: [id])

  translations ContentTranslation[]
  media        ContentMedia[]
  tags         ContentTag[]
  displays     ContentDisplay[]
  seo          ContentSEO?

  @@index([content_type_id])
  @@index([category_id])
  @@index([collection_id])
  @@index([style_id])
  @@index([body_placement_id])
  @@index([status])
  @@index([published_at])
  @@map("contents")
}

model ContentTranslation {
  id                String   @id @default(uuid()) @db.Uuid
  content_id        String   @db.Uuid
  language_code     String
  title             String
  short_description String?
  description       String?
  story             String?
  inspiration       String?
  meaning           String?
  process           String?
  created_at        DateTime @default(now()) @db.Timestamptz()
  updated_at        DateTime @updatedAt @db.Timestamptz()

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([content_id, language_code])
  @@index([language_code])
  @@map("content_translations")
}

model ContentMedia {
  id         String    @id @default(uuid()) @db.Uuid
  content_id String    @db.Uuid
  media_type MediaType
  role       MediaRole
  s3_key     String
  alt_text   String?
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz()
  updated_at DateTime  @updatedAt @db.Timestamptz()

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@index([content_id])
  @@index([content_id, role])
  @@index([content_id, sort_order])
  @@map("content_media")
}

model ContentTag {
  content_id String   @db.Uuid
  tag_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz()

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([content_id, tag_id])
  @@index([tag_id])
  @@map("content_tags")
}

model ContentDisplay {
  id           String         @id @default(uuid()) @db.Uuid
  content_id   String         @db.Uuid
  surface      DisplaySurface
  display_type DisplayType
  sort_order   Int            @default(0)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamptz()
  updated_at   DateTime       @updatedAt @db.Timestamptz()

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([content_id, surface, display_type])
  @@index([surface, display_type])
  @@index([content_id])
  @@map("content_displays")
}

model ContentSEO {
  id            String   @id @default(uuid()) @db.Uuid
  content_id    String   @unique @db.Uuid
  og_image_key  String?
  canonical_url String?
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  translations ContentSEOTranslation[]

  @@map("content_seo")
}

model ContentSEOTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  content_seo_id   String   @db.Uuid
  language_code    String
  meta_title       String?
  meta_description String?
  keywords         String?
  og_title         String?
  og_description   String?
  created_at       DateTime @default(now()) @db.Timestamptz()
  updated_at       DateTime @updatedAt @db.Timestamptz()

  content_seo ContentSEO @relation(fields: [content_seo_id], references: [id], onDelete: Cascade)

  @@unique([content_seo_id, language_code])
  @@index([language_code])
  @@map("content_seo_translations")
}

// -----------------------------------------------------------------------------
// BLOG MODULE
// -----------------------------------------------------------------------------

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blog {
  id              String     @id @default(uuid()) @db.Uuid
  slug            String     @unique
  status          BlogStatus @default(DRAFT)
  author_name     String?
  reading_time    Int?
  cover_media_key String?
  published_at    DateTime?  @db.Timestamptz()
  created_at      DateTime   @default(now()) @db.Timestamptz()
  updated_at      DateTime   @updatedAt @db.Timestamptz()

  translations BlogTranslation[]
  seo          BlogSeo?

  @@index([status])
  @@index([published_at])
  @@map("blogs")
}

model BlogTranslation {
  id            String   @id @default(uuid()) @db.Uuid
  blog_id       String   @db.Uuid
  language_code String
  title         String
  excerpt       String?
  content       String
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  blog Blog @relation(fields: [blog_id], references: [id], onDelete: Cascade)

  @@unique([blog_id, language_code])
  @@index([language_code])
  @@map("blog_translations")
}

model BlogSeo {
  id            String   @id @default(uuid()) @db.Uuid
  blog_id       String   @unique @db.Uuid
  canonical_url String?
  og_image_key  String?
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  blog Blog @relation(fields: [blog_id], references: [id], onDelete: Cascade)

  translations BlogSeoTranslation[]

  @@map("blog_seo")
}

model BlogSeoTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  blog_seo_id      String   @db.Uuid
  language_code    String
  meta_title       String?
  meta_description String?
  keywords         String?
  og_title         String?
  og_description   String?
  created_at       DateTime @default(now()) @db.Timestamptz()
  updated_at       DateTime @updatedAt @db.Timestamptz()

  blog_seo BlogSeo @relation(fields: [blog_seo_id], references: [id], onDelete: Cascade)

  @@unique([blog_seo_id, language_code])
  @@index([language_code])
  @@map("blog_seo_translations")
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum FeedbackMediaType {
  VIDEO
  IMAGE
}

model Feedback {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  email              String?
  rating             Int
  status             FeedbackStatus @default(PENDING)
  is_featured        Boolean        @default(false)
  is_verified        Boolean        @default(false)
  consent_to_publish Boolean        @default(false)
  submitted_at       DateTime       @default(now()) @db.Timestamptz()
  published_at       DateTime?      @db.Timestamptz()
  created_at         DateTime       @default(now()) @db.Timestamptz()
  updated_at         DateTime       @updatedAt @db.Timestamptz()

  translations FeedbackTranslation[]
  media        FeedbackMedia[]

  @@index([status])
  @@index([is_featured])
  @@index([is_verified])
  @@index([published_at])
  @@index([submitted_at])
  @@map("feedback")
}

model FeedbackTranslation {
  id            String @id @default(uuid()) @db.Uuid
  feedback_id   String @db.Uuid
  language_code String
  content       String

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  feedback Feedback @relation(fields: [feedback_id], references: [id], onDelete: Cascade)

  @@unique([feedback_id, language_code])
  @@index([language_code])
  @@map("feedback_translations")
}

model FeedbackMedia {
  id          String            @id @default(uuid()) @db.Uuid
  feedback_id String            @db.Uuid
  media_type  FeedbackMediaType
  s3_key      String
  mime_type   String?
  sort_order  Int               @default(0)
  is_active   Boolean           @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  feedback Feedback @relation(fields: [feedback_id], references: [id], onDelete: Cascade)

  @@index([feedback_id])
  @@index([media_type])
  @@index([is_active])
  @@index([sort_order])
  @@map("feedback_media")
}
